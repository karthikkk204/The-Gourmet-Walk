# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=3001
APP_BASE_URL=http://localhost:5173

# MySQL database (create schema using database/ scripts first)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Admin dashboard: set a strong, unique password in production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=

# Replace these with verified real business details
BUSINESS_NAME=The Gourmet Walk
BUSINESS_ADDRESS=
BUSINESS_LOCATION_LABEL=
BUSINESS_TIME_ZONE=UTC
BUSINESS_HOURS=
BUSINESS_LATITUDE=
BUSINESS_LONGITUDE=
BUSINESS_DIRECTIONS_URL=
TOUR_CURRENCY=INR
BOOKING_CANCELLATION_HOURS=24
BUSINESS_PHONE=
BUSINESS_EMAIL=

# Payments: keep test mode until Stripe and its webhook are configured
PAYMENT_MODE=test
PAYMENT_CURRENCY=INR
TAX_RATE_PERCENT=0
SHIPPING_FEE=0
FREE_SHIPPING_THRESHOLD=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional email notifications (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM=
